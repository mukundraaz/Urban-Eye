# Urban Eye Environment Configuration
# Copy this file to .env and fill in values

# Database (PostgreSQL recommended; use sqlite:///./urbaneye.db for local dev)
DATABASE_URL=postgresql://urbaneye:urbaneye_pass@localhost:5432/urbaneye_db

# JWT Authentication
SECRET_KEY=change-this-to-a-random-32-character-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# AI Mode: "demo" uses sample data, "model" calls YOLO pipeline
AI_MODE=demo

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional, for celery background tasks)
REDIS_URL=redis://localhost:6379/0
